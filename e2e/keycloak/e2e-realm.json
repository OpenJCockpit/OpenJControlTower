{
  "realm": "openjcontroltower",
  "enabled": true,
  "displayName": "OpenJControlTower E2E (test only)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "controltower-viewer" },
      { "name": "controltower-editor" },
      { "name": "controltower-admin" }
    ]
  },
  "clients": [
    {
      "clientId": "controltower-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "controltower-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "openjcontroltower", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "e2e-editor",
      "enabled": true,
      "email": "e2e-editor@example.invalid",
      "emailVerified": true,
      "firstName": "E2E",
      "lastName": "Editor",
      "realmRoles": ["controltower-editor"],
      "credentials": [{ "type": "password", "value": "E2E-only-editor-1!", "temporary": false }]
    },
    {
      "username": "e2e-admin",
      "enabled": true,
      "email": "e2e-admin@example.invalid",
      "emailVerified": true,
      "firstName": "E2E",
      "lastName": "Admin",
      "realmRoles": ["controltower-admin"],
      "credentials": [{ "type": "password", "value": "E2E-only-admin-1!", "temporary": false }]
    },
    {
      "username": "e2e-viewer",
      "enabled": true,
      "email": "e2e-viewer@example.invalid",
      "emailVerified": true,
      "firstName": "E2E",
      "lastName": "Viewer",
      "realmRoles": ["controltower-viewer"],
      "credentials": [{ "type": "password", "value": "E2E-only-viewer-1!", "temporary": false }]
    }
  ]
}
