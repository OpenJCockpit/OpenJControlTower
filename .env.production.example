# Reference only: create secrets using your orchestrator / secret manager; do not commit values.
POSTGRES_DB=controltower
POSTGRES_USER=controltower
POSTGRES_PASSWORD=REPLACE_WITH_EXTERNAL_SECRET
KEYCLOAK_ISSUER_URI=https://identity.example.org/realms/engineering
KEYCLOAK_JWKS_URI=https://identity.example.org/realms/engineering/protocol/openid-connect/certs
# Generate with: openssl rand -base64 48 / openssl rand -hex 16. Losing them makes stored Git secrets unreadable.
GIT_CREDENTIALS_SECRET=REPLACE_WITH_EXTERNAL_SECRET
GIT_CREDENTIALS_SALT=REPLACE_WITH_HEX_SALT
AI_ENABLED=true
OPENAI_API_KEY=REPLACE_WITH_EXTERNAL_SECRET
AI_MODEL=gpt-4o-mini
COCKPIT_ENABLED=true
COCKPIT_BASE_URL=https://cockpit.example.org
COCKPIT_TOKEN_URI=https://identity.example.org/realms/engineering/protocol/openid-connect/token
COCKPIT_CLIENT_ID=openjcontroltower-service
COCKPIT_CLIENT_SECRET=REPLACE_WITH_EXTERNAL_SECRET
CONTROLTOWER_EDITOR_ROLE=controltower-editor
CONTROLTOWER_ADMIN_ROLE=controltower-admin
# Open Policy Agent (settings page default). Policy values: infrastructure/opa/policies/openjcontroltower/config/data.json
OPA_ENABLED=true
DECISION_PROVIDER=deterministic
DECISION_API_KEY=
DECISION_ENDPOINT=https://api.laya.studio/v1/systemone
VITE_KEYCLOAK_URL=https://identity.example.org
VITE_KEYCLOAK_REALM=engineering
VITE_KEYCLOAK_CLIENT_ID=openjcontroltower-web
