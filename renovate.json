{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "* 2-6 * * 1"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security"
    ],
    "automerge": false
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Major upgrades require explicit review and passing CI",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major-update"
      ],
      "automerge": false
    },
    {
      "description": "Keep related React and React DOM packages together",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "React ecosystem"
    },
    {
      "description": "Group non-major GitHub Actions revisions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "GitHub Actions non-major updates"
    },
    {
      "description": "The Playwright npm package and its Docker image must move together (browsers are bundled in the image)",
      "matchPackageNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright"
      ],
      "groupName": "Playwright"
    },
    {
      "description": "Update the Open Policy Agent image everywhere at once",
      "matchDepNames": [
        "openpolicyagent/opa"
      ],
      "groupName": "Open Policy Agent"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Open Policy Agent image used outside Dockerfiles (CI policy tests, docs)",
      "fileMatch": [
        "^\\.github/workflows/ci\\.yml$",
        "^README\\.md$",
        "^docs/QUICKSTART\\.md$"
      ],
      "matchStrings": [
        "openpolicyagent/opa:(?<currentValue>[0-9][^\\s\"']*)"
      ],
      "depNameTemplate": "openpolicyagent/opa",
      "datasourceTemplate": "docker"
    }
  ]
}
