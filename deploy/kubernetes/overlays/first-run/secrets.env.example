# Copy to secrets.env (git-ignored) and fill in. Prefer an external secret manager
# (External Secrets Operator, Sealed Secrets, Vault) beyond a first run.
DB_PASSWORD=CHANGE-ME-long-random-value
COCKPIT_CLIENT_SECRET=CHANGE-ME
# Encrypts the Git tokens and passwords stored per repository. Generate once and keep them:
#   openssl rand -base64 48    and    openssl rand -hex 16
# Losing or changing them makes every stored Git secret unreadable.
GIT_CREDENTIALS_SECRET=CHANGE-ME-at-least-32-random-characters
GIT_CREDENTIALS_SALT=CHANGE0ME0HEX0SALT
# Keep a non-empty placeholder while AI_ENABLED=false.
OPENAI_API_KEY=unused-in-demo-mode
DECISION_API_KEY=
