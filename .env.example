# LOCAL DEVELOPMENT ONLY: replace secrets and use TLS in production
POSTGRES_DB=controltower
POSTGRES_USER=controltower
POSTGRES_PASSWORD=dev-change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-change-me
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/openjcontroltower
KEYCLOAK_JWKS_URI=http://keycloak:8081/realms/openjcontroltower/protocol/openid-connect/certs
# Git: credentials are encrypted with this key and salt (hex). Changing them makes stored secrets unreadable.
GIT_CREDENTIALS_SECRET=dev-only-change-me-at-least-32-characters
GIT_CREDENTIALS_SALT=5c0744940b5c369b
# Allows the http:// URL of the development Git server (git-server service).
GIT_ALLOW_HTTP=true
GIT_SERVER_PASSWORD=DevOnly-git-123
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
COCKPIT_ENABLED=false
COCKPIT_BASE_URL=http://host.docker.internal:8082
COCKPIT_CLIENT_ID=openjcontroltower-service
COCKPIT_CLIENT_SECRET=change-me-local
COCKPIT_TOKEN_URI=http://keycloak:8081/realms/openjcontroltower/protocol/openid-connect/token
DECISION_PROVIDER=deterministic
DECISION_API_KEY=
DECISION_ENDPOINT=https://api.laya.studio/v1/systemone
CONTROLTOWER_EDITOR_ROLE=controltower-editor
CONTROLTOWER_ADMIN_ROLE=controltower-admin
# Open Policy Agent (default for the settings page). Policy values: infrastructure/opa/policies/openjcontroltower/config/data.json
OPA_ENABLED=true
